{
  "name": "@cursos/blackboard",
  "version": "0.1.0",
  "description": "Pizarra plegable integrada para cursos interactivos: canvas Excalidraw, asistente IA y puente WebR.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./persistence": {
      "types": "./src/lib/persistence/index.ts",
      "default": "./src/lib/persistence/index.ts"
    },
    "./rag": {
      "types": "./src/lib/rag/index.ts",
      "default": "./src/lib/rag/index.ts"
    },
    "./assistant": {
      "types": "./src/lib/assistant/index.ts",
      "default": "./src/lib/assistant/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "next": "^14 || ^15",
    "@excalidraw/excalidraw": "^0.17 || ^0.18"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4"
  }
}
